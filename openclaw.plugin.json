{
  "id": "acedatacloud",
  "name": "Ace Data Cloud",
  "description": "Ace Data Cloud aggregates chat, image, video, music, and web-search across 50+ AI models behind a single OpenAI-compatible endpoint.",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": ["acedatacloud"],
  "modelIdNormalization": {
    "providers": {
      "acedatacloud": {
        "prefixWhenBare": "acedatacloud"
      }
    }
  },
  "providerRequest": {
    "providers": {
      "acedatacloud": {
        "family": "openai-compatible"
      }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "acedatacloud",
        "envVars": ["ACEDATA_API_KEY", "ACEDATACLOUD_API_KEY"]
      }
    ]
  },
  "providerAuthChoices": [
    {
      "provider": "acedatacloud",
      "method": "api-key",
      "choiceId": "acedatacloud-api-key",
      "choiceLabel": "Ace Data Cloud API key",
      "groupId": "acedatacloud",
      "groupLabel": "Ace Data Cloud",
      "groupHint": "API key",
      "onboardingScopes": ["text-inference"],
      "optionKey": "acedataApiKey",
      "cliFlag": "--acedata-api-key",
      "cliOption": "--acedata-api-key <key>",
      "cliDescription": "Ace Data Cloud API key (https://platform.acedata.cloud)"
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "webSearch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": { "type": ["string", "object"] },
          "baseUrl": { "type": "string" }
        }
      }
    }
  },
  "contracts": {
    "webSearchProviders": ["acedatacloud"]
  },
  "uiHints": {
    "webSearch.apiKey": {
      "label": "Ace Data Cloud Search API Key",
      "help": "Reuses your Ace Data Cloud API key for SERP search; falls back to ACEDATA_API_KEY env var.",
      "sensitive": true,
      "placeholder": "ace-..."
    },
    "webSearch.baseUrl": {
      "label": "Ace Data Cloud Base URL",
      "help": "Override the Ace Data Cloud API base URL (defaults to https://api.acedata.cloud)."
    }
  }
}
