{
  "id": "ace-gpt-image",
  "name": "GPT Image by Ace Data Cloud",
  "description": "GPT Image by Ace Data Cloud: native image generation and 5 optional service tools for OpenClaw.",
  "categories": [
    "media"
  ],
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": [
    "ace-gpt-image"
  ],
