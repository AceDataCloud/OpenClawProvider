      "groupLabel": "GPT Image by Ace Data Cloud",
      "groupHint": "GPT Image image",
      "onboardingScopes": [
        "image-generation"
      ],
      "optionKey": "gptImageAceApiKey",
      "cliFlag": "--gpt-image-ace-api-key",
      "cliOption": "--gpt-image-ace-api-key <key>",
      "cliDescription": "GPT Image Ace Data Cloud API key"
    }
  ],
