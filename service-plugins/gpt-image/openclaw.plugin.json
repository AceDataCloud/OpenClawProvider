          ]
        }
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": [
          "string",
          "object"
        ]
      }
    }
  },
  "configContracts": {
    "secretInputs": {
